generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  VERIFIED
  DISCREPANCY_FLAGGED
  REJECTED
}

model Order {
  id             String       @id @default(uuid())
  customerName   String
  customerPhone  String
  expectedAmount Float
  status         OrderStatus  @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  transaction    Transaction?
  auditLogs      AuditLog[]
}

model Transaction {
  id           String     @id @default(uuid())
  // Unique so a replayed/duplicate SMS can never be credited twice.
  momoTxId     String     @unique
  senderName   String
  senderPhone  String
  amountPaid   Float
  rawSms       String
  // Extracted from the SMS; not part of the original spec model but required by the parsing requirement.
  provider     String?
  transactedAt DateTime?
  orderId      String?    @unique
  order        Order?     @relation(fields: [orderId], references: [id])
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]
}

// Append-only audit trail of agent state transitions and human decisions.
model AuditLog {
  id            String       @id @default(uuid())
  runId         String
  event         String
  message       String
  data          Json?
  orderId       String?
  order         Order?       @relation(fields: [orderId], references: [id])
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([runId])
  @@index([createdAt])
}
